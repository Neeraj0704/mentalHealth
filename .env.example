# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, good for prototyping):
DATABASE_URL=sqlite:///./mental_health.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/mental_health

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-4-6

# ── HTTP Behavior ─────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=30          # seconds per request
MAX_RETRIES=3               # retries on transient errors (5xx, network)
RETRY_BACKOFF=2.0           # exponential backoff multiplier
REQUESTS_PER_SECOND=0.5     # 0.5 = 1 request every 2 seconds (polite crawling)
USER_AGENT=Mozilla/5.0 (compatible; MentalHealthPipeline/1.0; +research)

# ── Pipeline Behavior ─────────────────────────────────────────────────────────
# Comma-separated list of adapter names to enable.
# Available: zocdoc, webmd, mock
ENABLED_SOURCES=mock
# Set to true to use saved HTML fixtures instead of live requests (dev/testing)
DEV_MODE=true
# Set to true to use headless Chromium (Playwright) for JS-rendered pages.
# Requires: pip install playwright>=1.40.0 && playwright install chromium
# WebMD search results do NOT require Playwright (data is server-embedded).
USE_PLAYWRIGHT=false

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
